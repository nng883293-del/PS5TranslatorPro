<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scanBoxRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_scan_box">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="#CC090E1A"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="منطقة السابتايتل (اسحب للتحريك)"
        android:textColor="#84CC16"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnConfirmArea"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="@color/accent_green"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="تأكيد ✓"
        android:textColor="#090E1A"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/resizeHandle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|end"
        android:background="#CC84CC16"
        android:gravity="center"
        android:text="⤡"
        android:textColor="#090E1A"
        android:textSize="16sp"
        android:textStyle="bold" />
</FrameLayout>
